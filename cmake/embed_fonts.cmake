# Writes the C++ file that holds the panel fonts (see ui/fonts.h); the CMake counterpart of ui/fonts.S, for compilers
# without GNU as .incbin.  Script mode:
#   cmake -DFONT_DIR=<third_party/fonts> -DOUT=<file.cpp> -P embed_fonts.cmake
set(fonts
	eiii_font_regular NotoSans-CondensedMedium.ttf
	eiii_font_bold    NotoSans-CondensedSemiBold.ttf
	eiii_font_narrow  ArchivoNarrow-wght.ttf)
set(src "// generated by cmake/embed_fonts.cmake from third_party/fonts: do not edit\n#include \"ui/fonts.h\"\n\n")
list(LENGTH fonts n)
math(EXPR last "${n} - 1")
foreach(i RANGE 0 ${last} 2)
	math(EXPR j "${i} + 1")
	list(GET fonts ${i} sym)
	list(GET fonts ${j} file)
	file(READ "${FONT_DIR}/${file}" hex HEX)
	string(LENGTH "${hex}" hexlen)
	math(EXPR size "${hexlen} / 2")
	string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
	string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
	string(APPEND src "alignas(16) unsigned char const ${sym}[] = {\n${bytes}\n};\nstd::size_t const ${sym}_size = ${size};\n\n")
endforeach()
file(WRITE "${OUT}.tmp" "${src}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
